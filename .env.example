# Copie para .env e ajuste se quiser. Sem .env o projeto sobe com estes mesmos defaults.

# Linux/macOS: rode `echo "AIRFLOW_UID=$(id -u)" >> .env`. No Windows pode manter 50000.
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=apache/airflow:2.10.5

# Usuário da UI do Airflow
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Base analítica (exposta em localhost:5433)
ANALYTICS_DB_USER=shopbrasil
ANALYTICS_DB_PASSWORD=shopbrasil
ANALYTICS_DB_NAME=shopbrasil

# API de catálogo
FAKESTORE_BASE_URL=https://fakestoreapi.com
